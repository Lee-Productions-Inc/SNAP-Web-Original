RewriteEngine On

Options -Indexes

RewriteRule (^|/)\.(git|history|migration-[^/]*|settings-[^/]*-backup[^/]*|vscode)(/|$) - [F,NC,L]
RewriteRule (^|/)server(/|$) - [F,NC,L]
RewriteRule (^|/)\.env(?:\.[^/]*)?$ - [F,NC,L]
RewriteRule (^|/)(?:[^/]+\.)?(?:bak|backup|old|orig|sql|log|pem|key|p12|pfx)$ - [F,NC,L]

<IfModule mod_authz_core.c>
    <FilesMatch "(?i)^(?:\.env(?:\..*)?|.*\.(?:bak|backup|old|orig|sql|log|pem|key|p12|pfx))$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "(?i)^(?:\.env(?:\..*)?|.*\.(?:bak|backup|old|orig|sql|log|pem|key|p12|pfx))$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

RewriteCond %{REQUEST_URI} ^(.*/)pages/
RewriteRule "^pages/dashboard/badges\.html$" "%1pages/dashboard/badges.php" [R=301,L]
RewriteCond %{REQUEST_URI} ^(.*/)pages/
RewriteRule "^pages/dashboard/dashboard\.html$" "%1pages/dashboard/dashboard.php" [R=301,L]
