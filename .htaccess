RewriteRule "^pages/dashboard/profile/profile\.html$" "%1pages/dashboard/profile/profile.php" [R=301,L]
RewriteCond %{REQUEST_URI} ^(.*/)pages/
RewriteRule "^pages/dashboard/profile/settings/about\.html$" "%1pages/dashboard/profile/settings/about.php" [R=301,L]
RewriteCond %{REQUEST_URI} ^(.*/)pages/
RewriteRule "^pages/dashboard/profile/settings/account_settings\.html$" "%1pages/dashboard/profile/settings/account_settings.php" [R=301,L]
