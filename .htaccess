RewriteCond %{REQUEST_URI} ^(.*/)pages/
RewriteRule "^pages/dashboard/folders/recently_deleted\.html$" "%1pages/dashboard/folders/recently_deleted.php" [R=301,L]
RewriteCond %{REQUEST_URI} ^(.*/)pages/
RewriteRule "^pages/dashboard/folders/unclassified\.html$" "%1pages/dashboard/folders/unclassified.php" [R=301,L]
RewriteCond %{REQUEST_URI} ^(.*/)pages/
